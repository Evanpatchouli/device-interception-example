{
  "name": "device-interception-example",
  "version": "1.1.0",
  "description": "An example Node.js application to capture keyboard and mouse strokes.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "set NODE_ENV=production && node --env-file-if-exists=.env index.js",
    "start:node": "set NODE_ENV=production && node --env-file-if-exists=.env index.js",
    "serve": "set NODE_ENV=production && node --env-file-if-exists=.env serve.js",
    "serve:node": "set NODE_ENV=production && node --env-file-if-exists=.env serve.js",
    "install:driver": "npx node-interception /install",
    "uninstall:driver": "npx node-interception /uninstall",
    "check": "node check.js",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "lint": "eslint --config monitor/eslint.config.js monitor/src",
    "web": "vite",
    "build:web": "vite build",
    "deploy-web": "node ./scripts/deploy-web.cjs"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "evp-design-ui": "^0.0.14-beta",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "node-interception": "^2.0.4",
    "react": "^18.3.1",
    "react-calendar": "^5.0.0",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5",
    "workerpool": "^9.1.3",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.9.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "vite": "^5.4.1"
  }
}
